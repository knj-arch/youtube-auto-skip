{
  "manifest_version": 3,
  "name": "유튜브 자동 건너뛰기",
  "version": "1.0.3",
  "minimum_chrome_version": "106",
  "description": "유튜브 광고를 감지하면 설정한 횟수만큼 새로고침하고, 광고가 계속되면 건너뛰기 버튼을 자동으로 누릅니다.",
  "permissions": ["storage", "debugger"],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "유튜브 자동 건너뛰기",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
